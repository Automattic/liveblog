{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2020", "DOM"],
		"jsx": "react-jsx",
		"allowJs": true,
		"checkJs": false,
		"strict": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"rootDir": "./src"
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "build"]
}
